<?xml version="1.0"?>
<robot name="offset_drone">
  <link name="base">
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.04"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry><box size="0.3 0.3 0.06"/></geometry>
    </visual>
  </link>
  <link name="cable_attachment"/>
  <joint name="cable_mount" type="fixed">
    <parent link="base"/>
    <child link="cable_attachment"/>
    <origin xyz="0.15 0 -0.1"/>
  </joint>
</robot>
