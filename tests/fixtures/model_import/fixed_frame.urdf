<?xml version="1.0"?>
<!-- CSim-owned parser fixture. Explicit inertias are independent of visuals. -->
<robot name="fixed_frame">
  <material name="cyan"><color rgba="0.1 0.7 0.9 1"/></material>
  <link name="base">
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 1.5707963267948966"/>
      <mass value="2"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>
    <visual name="base_box">
      <geometry><box size="0.4 0.2 0.1"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>
  <link name="arm">
    <inertial>
      <origin xyz="0 0.1 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/>
    </inertial>
    <visual name="arm_cylinder">
      <origin xyz="0.02 0 0"/>
      <geometry><cylinder radius="0.03" length="0.2"/></geometry>
      <material name="cyan"/>
    </visual>
  </link>
  <joint name="arm_mount" type="fixed">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="0.4 0 0.1" rpy="0 0 1.5707963267948966"/>
  </joint>
</robot>
