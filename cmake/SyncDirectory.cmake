if(NOT IS_DIRECTORY "${SOURCE}")
    message(FATAL_ERROR "Missing source directory: ${SOURCE}")
endif()
if(NOT DEFINED DESTINATION OR DESTINATION STREQUAL "")
    message(FATAL_ERROR "Destination directory is required")
endif()

file(REAL_PATH "${SOURCE}" source_path)
get_filename_component(destination_path "${DESTINATION}" ABSOLUTE)
if(EXISTS "${DESTINATION}")
    file(REAL_PATH "${DESTINATION}" destination_path)
endif()
if(source_path STREQUAL destination_path)
    return()
endif()
file(RELATIVE_PATH relative_source "${destination_path}" "${source_path}")
if(NOT IS_ABSOLUTE "${relative_source}" AND NOT relative_source MATCHES "^\\.\\./")
    message(FATAL_ERROR "Destination must not contain the source directory")
endif()

file(REMOVE_RECURSE "${DESTINATION}")
file(COPY "${SOURCE}/" DESTINATION "${DESTINATION}")
